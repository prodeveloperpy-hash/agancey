DirectoryIndex index.html

Options -MultiViews
RewriteEngine On

# Portfolio route (static /Fiazhussain/ folder on disk would otherwise 403).
RewriteRule ^Fiazhussain/?$ index.html [L]

# Serve existing files and directories normally.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Missing static assets must 404 — never return index.html as JS/CSS.
RewriteCond %{REQUEST_URI} ^/assets/
RewriteRule ^ - [R=404,L]

# React Router SPA fallback.
RewriteRule ^ index.html [L]
